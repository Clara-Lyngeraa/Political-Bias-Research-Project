#!/bin/bash
#SBATCH --job-name=create_and_test
#SBATCH --output=create_and_test.out
#SBATCH --error=create_and_test.err
#SBATCH --cpus-per-task=10
#SBATCH --nodes=1
#SBATCH --nodelist=asus1
#SBATCH --time=72:00:00
#SBATCH --partition=asus1

set -e
set -x 

echo "START: $(date)"
cd /temp
mkdir -p mgon_MY_OWN_MINICONDA_MARCH26
mkdir -p mgon_CACHE_MY_OWN_MINICONDA_MARCH26
mkdir -p mgon_tmp
export CONDA_PKGS_DIRS=/temp/mgon_CACHE_MY_OWN_MINICONDA_MARCH26
export TMPDIR=/temp/mgon_tmp
export TMP_DIR=/temp/mgon_tmp
export TMP=/temp/mgon_tmp
export TEMP=/temp/mgon_tmp
export PIP_CACHE_DIR=/temp/mgon_CACHE_MY_OWN_MINICONDA_MARCH26

# on asus1 you have /temp instead of /scratch: please, rename everywhere if you submit!!!

cd mgon_MY_OWN_MINICONDA_MARCH26

source /usr/local/minicondas/Miniconda3-py313_26.7.1-1-Linux-aarch64/etc/profile.d/conda.sh
conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main
conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r
conda create -y -p /temp/mgon_MY_OWN_MINICONDA_MARCH26/Miniconda3-py313_26.7.1-1-Linux-aarch64/envs/newpy_pip python=3.12
conda activate /temp/mgon_MY_OWN_MINICONDA_MARCH26/Miniconda3-py313_26.7.1-1-Linux-aarch64/envs/newpy_pip

echo "pip installing"
pip install tqdm ollama

echo "testing the environment"
# sanity check
python3 - << 'EOF'
import tqdm
import ollama
print("tqdm version:", tqdm.__version__)
EOF

# working on project
cd /temp
mkdir -p myproject
cd myproject
cp -r /home/mgon/Political-Bias-Research-Project/* .
python3 src/handle_data/open_to_closed.py \
  --model_id llama3:8b \
  --input_path data/output \
  --output_path data/output/converted
cp -r ./data/output/converted /home/mgon/Political-Bias-Research-Project/data/output/converted
cd /temp
echo "FINISH: $(date)"
echo "DONE"

# cleaning after yourselves
rm -rf myproject
rm -rf mgon_tmp
rm -rf mgon_MY_OWN_MINICONDA_MARCH26
rm -rf mgon_CACHE_MY_OWN_MINICONDA_MARCH26
